{
  "name": "medabot-agents",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "license": "MIT",
  "description": "Telegram gateway for Claude Code and Codex agent sessions",
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@grammyjs/auto-retry": "^2.0.2",
    "@openai/codex-sdk": "^0.166.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
