# From @BotFather (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=

# Leave these two empty on first run: the bot starts in setup mode and
# answers /whoami with both ids. Fill them in and restart.
# The forum supergroup (Topics enabled), e.g. -1001234567890
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to use the bot.
TELEGRAM_ALLOWED_USER_IDS=

# Local voice transcription on the gateway: install whisper.cpp + FFmpeg (see README).
# Defaults shown below. No OpenAI API key is needed.
# WHISPER_MODEL_PATH=~/.cache/manglr/ggml-small.bin
# WHISPER_PATH=whisper-cli
# FFMPEG_PATH=ffmpeg

# Folder every session starts in (default: your home directory).
# AGENT_CWD=~/Code
# Where the topic ↔ session mapping is kept.
DATA_DIR=data
# Other computers to run agents on, over SSH (see hosts.example.json).
# No file: everything runs on this host.
HOSTS_FILE=hosts.json

# Claude Code (Agent SDK). Unset model/effort = your Claude Code defaults.
# The model is the default for new threads; /model switches it per thread.
# CLAUDE_MODEL=
# CLAUDE_EFFORT=high
# default | acceptEdits | plan | dontAsk | auto | bypassPermissions
CLAUDE_PERMISSION_MODE=default
# CLAUDE_PATH=/Users/you/.local/bin/claude

# Codex (Codex SDK). Codex has no approval callback: it runs sandboxed.
# Unset model = the one in ~/.codex/config.toml; /model switches it per thread.
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=medium
# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write
CODEX_NETWORK_ACCESS=false
# CODEX_PATH=/usr/local/bin/codex

# DEBUG=1
